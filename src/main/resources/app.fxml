<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="466.0" prefWidth="387.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CartController">
    <children>
        <Button fx:id="enButton" layoutX="135.0" layoutY="406.0" mnemonicParsing="false" onAction="#onClickChangetoEn" text="EN" />
        <Button fx:id="fiButton" layoutX="175.0" layoutY="406.0" mnemonicParsing="false" onAction="#onClickChangetoFi" text="FI" />
        <Button fx:id="svButton" layoutX="211.0" layoutY="406.0" mnemonicParsing="false" onAction="#onClickChangetoSv" text="SV" />
        <Button fx:id="jaButton" layoutX="251.0" layoutY="406.0" mnemonicParsing="false" onAction="#onClickChangetoJa" text="JA" />
        <Label fx:id="titleLabel" layoutX="75.0" layoutY="14.0" prefHeight="52.0" prefWidth="237.0" text="Shopping Cart Calculator">
         <font>
            <Font size="21.0" />
         </font></Label>
        <TextField fx:id="amountOfAllField" layoutX="62.0" layoutY="103.0" prefHeight="26.0" prefWidth="259.0" promptText="Amount of different products:" />
        <TextField fx:id="piecesField" layoutX="62.0" layoutY="191.0" prefHeight="26.0" prefWidth="259.0" promptText="How many pieces:" />
        <TextField fx:id="priceField" layoutX="64.0" layoutY="233.0" prefHeight="26.0" prefWidth="259.0" promptText="Price per piece:" />
        <Label fx:id="result" alignment="TOP_LEFT" layoutX="64.0" layoutY="310.0" prefHeight="96.0" prefWidth="259.0" text="Results are shown here" wrapText="true" />
        <Button fx:id="addItemButton" layoutX="254.0" layoutY="267.0" mnemonicParsing="false" onAction="#onClickAddItem" text="Add Item" />
      <Label fx:id="itemNumLabel" layoutX="64.0" layoutY="160.0" text="1. Item">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="scanButton" layoutX="224.0" layoutY="135.0" mnemonicParsing="false" onAction="#onClickStartScan" text="Start Scanning" />
      <Button fx:id="arButton" layoutX="290.0" layoutY="406.0" mnemonicParsing="false" onAction="#onClickChangetoAr" text="AR" />
    </children>
</AnchorPane>
